#include <stdio.h>

main ()
{
	int x = 2,y = 3,z = 8;
	
	x++;
	x=z;
	++y;
	--z;
	
	printf ("%d %d %d\n", x, y, z);
	printf ("%d %d %d\n", x++, ++y, z--);
	printf ("%d %d %d\n", x, y, z);
	printf ("%d %d %d\n", ++x, y++, ++z);
	printf ("%d %d %d\n", x--, --y, --z);
	printf ("%d %d %d\n", ++x, ++y, z++);
	printf ("%d %d %d\n", x + 4, y + 2, z - 1);
	printf ("%d %d %d\n", x, y, z);
}
